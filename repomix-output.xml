<file path="Frontend/Views/Reproductor-Universal.html">
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Reproductor Universal</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Google Fonts (Inter) -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">

  <style>
    /* ============================================================
       RESET Y BASE — fondo con imagen original y overlay
    ============================================================ */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 20px;
      font-family: 'Inter', 'Segoe UI', 'Roboto', sans-serif;
      /* Fondo original con imagen */
      background: url(https://static.wixstatic.com/media/8a7da0_da693a5c2b2d42bbb084707197421b0a~mv2.png) center/cover no-repeat fixed;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #1a1a2e;
      position: relative;
    }

    /* Overlay suave (original) */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.25);
      backdrop-filter: blur(4px);
      z-index: 0;
    }

    /* ============================================================
       CONTENEDOR PRINCIPAL — glassmorphism azulado
    ============================================================ */
    .container {
      position: relative;
      z-index: 1;
      display: flex;
      width: 94%;
      max-width: 1440px;
      background: rgba(255, 255, 255, 0.70);
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
      border-radius: 32px;
      box-shadow: 0 20px 40px -12px rgba(13, 71, 161, 0.20), inset 0 1px 0 rgba(255,255,255,0.7);
      border: 1px solid rgba(255,255,255,0.5);
      overflow: hidden;
      transition: all 0.3s ease;
    }

    /* ============================================================
       REPRODUCTOR (columna izquierda)
    ============================================================ */
    .main-player {
      flex: 3;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* Botón volver — estilo azul */
    .back-button {
      background: rgba(13, 71, 161, 0.08);
      color: #0d47a1;
      border: 1px solid rgba(13, 71, 161, 0.15);
      padding: 10px 20px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.25s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: fit-content;
      font-family: inherit;
      backdrop-filter: blur(4px);
    }

    .back-button:hover {
      background: #0d47a1;
      color: #fff;
      border-color: #0d47a1;
      transform: scale(1.03);
      box-shadow: 0 6px 16px rgba(13, 71, 161, 0.2);
    }

    /* Barra de controles */
    .controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .episode-selector {
      padding: 10px 16px;
      border-radius: 40px;
      border: 1px solid rgba(0,0,0,0.06);
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(4px);
      font-weight: 600;
      color: #1a1a2e;
      font-family: inherit;
      min-width: 160px;
      transition: all 0.25s ease;
      box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }

    .episode-selector:focus {
      outline: none;
      border-color: #0d47a1;
      box-shadow: 0 0 0 4px rgba(13, 71, 161, 0.08);
    }

    .controls-bar > div {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .control-btn {
      background: linear-gradient(135deg, #0d47a1, #0288d1);
      color: #fff;
      border: none;
      padding: 10px 18px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 4px 12px rgba(2, 136, 209, 0.25);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: inherit;
    }

    .control-btn:hover {
      transform: scale(1.04);
      box-shadow: 0 6px 20px rgba(13, 71, 161, 0.3);
      background: linear-gradient(135deg, #0a2a44, #0d47a1);
    }

    /* Contenedor de video */
    .video-container {
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      background: #000;
      position: relative;
    }

    .video-container iframe {
      width: 100%;
      height: 100%;
      border: none;
    }

    /* Detalles del video */
    .video-info {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
      font-size: 0.95rem;
      color: #1a1a2e;
      padding: 8px 16px;
      background: rgba(255,255,255,0.6);
      backdrop-filter: blur(4px);
      border-radius: 40px;
      border: 1px solid rgba(255,255,255,0.4);
      box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    /* ============================================================
       SECCIÓN RECOMENDACIONES (dentro del reproductor en desktop)
    ============================================================ */
    .recomendaciones-section {
      margin-top: 8px;
      padding-top: 16px;
      border-top: 2px solid rgba(13, 71, 161, 0.08);
    }

    .recomendaciones-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }

    .recomendaciones-header h3 {
      margin: 0;
      color: #0d47a1;
      font-size: 1.1rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .recomendaciones-header h3::before {
      content: '\f005';
      font-family: 'Font Awesome 6 Free';
      font-weight: 900;
      color: #0288d1;
      font-size: 0.9rem;
    }

    .service-status-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 4px 14px 4px 10px;
      border-radius: 40px;
      background: rgba(13, 71, 161, 0.08);
      color: #0d47a1;
      border: 1px solid rgba(13, 71, 161, 0.12);
      font-family: inherit;
    }

    .service-status-indicator i {
      font-size: 0.75rem;
    }

    .service-active { background: rgba(13, 71, 161, 0.08); color: #0d47a1; }
    .service-cloudflare { background: rgba(255, 107, 53, 0.08); color: #0d47a1; }
    .service-sheets { background: rgba(15, 157, 88, 0.08); color: #0d47a1; }

    .recomendaciones-grid {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      padding: 8px 2px 16px;
      scrollbar-width: thin;
      scrollbar-color: #0288d1 #e0e7ff;
    }

    .recomendaciones-grid::-webkit-scrollbar {
      height: 6px;
    }
    .recomendaciones-grid::-webkit-scrollbar-track {
      background: #e0e7ff;
      border-radius: 10px;
    }
    .recomendaciones-grid::-webkit-scrollbar-thumb {
      background: #0288d1;
      border-radius: 10px;
    }

    .recomendacion-card {
      flex: 0 0 auto;
      width: 200px;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(8px);
      border-radius: 18px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid rgba(255,255,255,0.6);
      cursor: pointer;
      position: relative;
    }

    .recomendacion-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, #0d47a1, #42a5f5, #0d47a1);
      background-size: 200% 100%;
      opacity: 0;
      transition: opacity 0.4s ease;
      z-index: 2;
    }

    .recomendacion-card:hover::before {
      opacity: 1;
      animation: cardBorderMove 2s ease infinite;
    }

    @keyframes cardBorderMove {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .recomendacion-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 16px 32px rgba(13, 71, 161, 0.12);
      border-color: rgba(13, 71, 161, 0.15);
    }

    .recomendacion-img {
      width: 100%;
      height: 240px;
      object-fit: cover;
      border-bottom: 2px solid rgba(255,255,255,0.3);
    }

    .recomendacion-info {
      padding: 14px 12px 16px;
      text-align: center;
    }

    .recomendacion-info h4 {
      margin: 0 0 6px 0;
      color: #1a1a2e;
      font-size: 0.95rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .recomendacion-info p {
      margin: 0 0 10px 0;
      color: #0d47a1;
      font-size: 0.8rem;
      font-weight: 600;
      background: rgba(255,255,255,0.5);
      padding: 2px 12px;
      border-radius: 20px;
      display: inline-block;
    }

    .btn-recomendacion {
      background: linear-gradient(135deg, #0d47a1, #0288d1);
      border: none;
      border-radius: 60px;
      padding: 8px 16px;
      color: #fff;
      font-weight: 600;
      font-size: 0.8rem;
      transition: all 0.3s ease;
      display: inline-block;
      text-decoration: none;
      cursor: pointer;
      width: 100%;
      box-shadow: 0 4px 12px rgba(2, 136, 209, 0.2);
      font-family: inherit;
    }

    .btn-recomendacion:hover {
      transform: scale(1.04);
      box-shadow: 0 6px 18px rgba(13, 71, 161, 0.3);
      background: linear-gradient(135deg, #0a2a44, #0d47a1);
    }

    .loading-recomendaciones {
      text-align: center;
      padding: 30px 10px;
      color: #1e3a5f;
      font-weight: 500;
    }

    /* ============================================================
       BARRA LATERAL (lista de episodios)
    ============================================================ */
    .sidebar {
      flex: 2;
      background: rgba(255, 255, 255, 0.45);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 20px 18px;
      overflow-y: auto;
      border-left: 1px solid rgba(255,255,255,0.3);
      display: flex;
      flex-direction: column;
      max-height: 800px;
    }

    .sidebar-header {
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 2px solid rgba(13, 71, 161, 0.08);
    }

    .sidebar-header h2 {
      margin: 0 0 4px 0;
      color: #1a1a2e;
      font-size: 1.2rem;
      font-weight: 700;
    }

    .sidebar-header .sub-info {
      font-size: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      color: #1e3a5f;
      font-weight: 500;
      margin-bottom: 10px;
    }

    #episodeCount {
      display: inline-block;
      background: rgba(13, 71, 161, 0.06);
      padding: 2px 14px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.8rem;
      border: 1px solid rgba(13, 71, 161, 0.08);
    }

    .server-select {
      width: 100%;
      padding: 10px 14px;
      border-radius: 40px;
      border: 1px solid rgba(0,0,0,0.06);
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(4px);
      font-weight: 600;
      color: #1a1a2e;
      font-family: inherit;
      margin-bottom: 12px;
      transition: all 0.25s ease;
    }

    .server-select:focus {
      outline: none;
      border-color: #0d47a1;
      box-shadow: 0 0 0 4px rgba(13, 71, 161, 0.08);
    }

    /* DROPDOWN DE SERVICIO */
    .service-dropdown {
      position: relative;
      display: inline-block;
      width: 100%;
      margin-top: 4px;
    }

    .service-dropdown-toggle {
      background: rgba(13, 71, 161, 0.06);
      color: #1a1a2e;
      font-weight: 600;
      padding: 10px 16px;
