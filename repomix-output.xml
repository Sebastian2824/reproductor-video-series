      padding: 18px 16px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      background: rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(4px);
      height: auto;
      overflow-wrap: break-word;
      word-break: break-word;
      gap: 4px;
    }

