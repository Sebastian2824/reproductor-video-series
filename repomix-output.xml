        width: 100%;
        height: 220px;
        border-radius: 20px 20px 0 0;
      }
      
      .card-contenido {
        padding: 14px;
      }
      
      .nombre-id {
        font-size: 1rem;
      }
      
      .titulo {
        font-size: 0.9rem;
      }
      
      .navegacion {
        gap: 12px;
      }
      
      .navegacion button {
        padding: 8px 16px;
        font-size: 0.8rem;
      }
    }

    @media (max-width: 480px) {
      body {
        padding: 12px;
      }
      
      .filtros {
        padding: 14px 16px;
        border-radius: 20px;
      }
      
      .selector-servicio button {
        font-size: 0.7rem;
        padding: 6px 12px;
      }
      
      .estado-servicio {
        font-size: 0.7rem;
      }
    }
