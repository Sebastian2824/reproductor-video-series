    }

    .service-dropdown-item .service-icon {
      font-size: 0.9rem;
      width: 24px;
      text-align: center;
      color: #0288d1;
    }

    .service-dropdown-item .service-check {
      color: #0f9d58;
      font-size: 0.8rem;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .service-dropdown-item.active .service-check {
      opacity: 1;
    }

    /* Lista de episodios */
    .episode-list {
      flex: 1;
      overflow-y: auto;
      margin-top: 8px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-right: 4px;
    }

    .episode-list::-webkit-scrollbar {
      width: 4px;
    }
    .episode-list::-webkit-scrollbar-track {
      background: transparent;
    }
    .episode-list::-webkit-scrollbar-thumb {
      background: #0288d1;
      border-radius: 10px;
    }

    .episode-item {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(4px);
      border-radius: 16px;
      display: flex;
      gap: 12px;
      padding: 10px 12px;
      cursor: pointer;
      transition: all 0.25s ease;
      border: 2px solid transparent;
      box-shadow: 0 2px 8px rgba(0,0,0,0.02);
      position: relative;
    }

    .episode-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, #0d47a1, #42a5f5);
      background-size: 200% 100%;
      opacity: 0;
      transition: opacity 0.4s ease;
      border-radius: 16px 16px 0 0;
    }

    .episode-item:hover::before,
    .episode-item.active::before {
      opacity: 1;
      animation: cardBorderMove 2s ease infinite;
    }

    .episode-item:hover {
      transform: scale(1.02);
      background: rgba(255, 255, 255, 0.8);
      border-color: rgba(13, 71, 161, 0.12);
    }

    .episode-item.active {
      background: rgba(13, 71, 161, 0.06);
      border-color: #0d47a1;
      box-shadow: 0 4px 12px rgba(13, 71, 161, 0.08);
    }

    .thumbnail {
      width: 100px;
      height: 64px;
      border-radius: 10px;
      object-fit: cover;
      border: 1px solid rgba(255,255,255,0.3);
    }

    .episode-info {
      display: flex;
      flex-direction: column;
      justify-content: center;
      flex: 1;
    }

    .episode-title {
      font-weight: 600;
      color: #1a1a2e;
      font-size: 0.9rem;
    }

    .episode-server {
      font-size: 0.7rem;
      color: #1e3a5f;
      background: rgba(255,255,255,0.3);
      padding: 2px 10px;
      border-radius: 20px;
      display: inline-block;
      margin-top: 4px;
      width: fit-content;
    }

    /* ============================================================
       RESPONSIVE
    ============================================================ */
    @media (max-width: 1024px) {
      .container { width: 96%; }
      .main-player { padding: 18px; }
      .sidebar { padding: 16px; }
    }

    @media (max-width: 900px) {
      body { padding: 12px; }
      
      .container {
        flex-direction: column;
        border-radius: 28px;
        width: 100%;
        max-width: 100%;
      }

      .main-player { order: 1; }
      .sidebar {
        order: 2;
        border-left: none;
        border-top: 2px solid rgba(255,255,255,0.3);
        max-height: none;
        padding: 16px;
      }

      .episode-list {
        flex-direction: row;
        overflow-x: auto;
        overflow-y: visible;
        gap: 12px;
        padding-bottom: 8px;
        flex-wrap: nowrap;
      }

      .episode-item {
        flex: 0 0 auto;
        width: 180px;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 12px;
      }

      .thumbnail {
        width: 100%;
        height: 100px;
        border-radius: 12px;
      }

      .episode-info {
        align-items: center;
      }

      .controls-bar {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
      }

      .controls-bar > div {
        justify-content: center;
      }

      .control-btn {
        flex: 1;
        justify-content: center;
      }

      .recomendaciones-section {
        order: 3;
        width: 100%;
        margin-top: 0;
        border-top: 2px solid rgba(13, 71, 161, 0.08);
        padding-top: 16px;
      }

      .recomendacion-card {
        width: 180px;
      }

      .recomendacion-img {
        height: 220px;
      }

      .video-info {
        font-size: 0.8rem;
        flex-wrap: wrap;
        gap: 4px;
      }
    }

    @media (max-width: 600px) {
      .container { border-radius: 24px; }
      .main-player { padding: 14px; }
      .sidebar { padding: 12px; }

      .episode-item {
        width: 150px;
        padding: 10px;
      }
      .thumbnail {
        height: 80px;
      }
      .recomendacion-card { width: 160px; }
      .recomendacion-img { height: 200px; }

      .video-info {
        font-size: 0.7rem;
        padding: 6px 12px;
      }
    }

    @media (max-width: 480px) {
      .episode-item {
        width: 130px;
        padding: 8px;
      }
      .thumbnail { height: 70px; }
      .recomendacion-card { width: 140px; }
      .recomendacion-img { height: 180px; }
      .sidebar-header h2 { font-size: 1rem; }
    }
    .service-sqlserver {
  background: rgba(0, 120, 212, 0.10);
  color: #0078D4;
}
  </style>
</head>
<body>
  <div class="container">
    <div class="main-player">
      <!-- Botón para volver al catálogo -->
      <button class="back-button" onclick="volverAlCatalogo()">
        <i class="fas fa-arrow-left"></i> Volver al Catálogo
      </button>
      
      <div class="controls-bar">
        <select class="episode-selector" onchange="selectEpisode(this.value)"></select>
        <div>
          <button class="control-btn" onclick="previousEpisode()"><i class="fas fa-step-backward"></i> Anterior</button>
          <button class="control-btn" onclick="nextEpisode()">Siguiente <i class="fas fa-step-forward"></i></button>
