    /* Barra de controles */
    .controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .episode-selector {
      padding: 10px 16px;
      border-radius: 40px;
      border: 1px solid rgba(0,0,0,0.06);
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(4px);
      font-weight: 600;
      color: #1a1a2e;
      font-family: inherit;
      min-width: 160px;
      transition: all 0.25s ease;
      box-shadow: 0 2px 6px rgba(0,0,0,0.02);
