      position: relative;
      z-index: 1;
      text-align: center;
      padding: 40px;
      font-size: 1.1rem;
      color: #1a1a2e;
      background: rgba(255, 255, 255, 0.70);
      backdrop-filter: blur(12px);
      border-radius: 28px;
      border: 1px solid rgba(255,255,255,0.5);
      margin: 20px auto;
      max-width: 600px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    }

    .mensaje-error {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 24px;
