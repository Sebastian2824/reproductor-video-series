    /* Indicador de servicio — badge azul claro */
    .service-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 10px;
      font-weight: 600;
      color: white;
      background: rgba(255, 255, 255, 0.12);
