      margin: 0 20px 40px 20px;
      display: flex;
      flex-direction: column;
    }

    .carta-superpuesta {
      transform: translate(30px, 20px);
      z-index: 2;
    }

    /* ============================================================
       TARJETA INDIVIDUAL — glassmorphism mejorado
    ============================================================ */
    .card {
      width: 100%;
      display: grid;
      grid-template-columns: 160px auto;
      align-items: start;
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 24px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
      border: 1px solid rgba(255,255,255,0.5);
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
    }

    /* Borde superior animado (como en las otras interfaces) */
    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, #0d47a1, #42a5f5, #0d47a1);
      background-size: 200% 100%;
      opacity: 0;
      transition: opacity 0.4s ease;
      z-index: 2;
    }

    .card:hover::before {
      opacity: 1;
      animation: cardBorderMove 2s ease infinite;
    }

    @keyframes cardBorderMove {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .card:hover {
      transform: scale(1.02);
      box-shadow: 0 16px 40px rgba(13, 71, 161, 0.10);
      border-color: rgba(13, 71, 161, 0.12);
    }

    .card-imagen {
      width: 160px;
      height: 250px;
      overflow: hidden;
      flex-shrink: 0;
    }

    .card-imagen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      transition: transform 0.5s ease;
    }

    .card:hover .card-imagen img {
      transform: scale(1.04);
    }

    .card-contenido {
      padding: 18px 16px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      background: rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(4px);
      height: auto;
      overflow-wrap: break-word;
      word-break: break-word;
      gap: 4px;
    }

    .nombre-id {
      font-size: 1.1rem;
      font-weight: 700;
      color: #1a1a2e;
      line-height: 1.2;
    }

    .titulo {
      font-weight: 600;
      font-size: 0.95rem;
      color: #0d47a1;
      line-height: 1.3;
    }

    .subtitulo {
      color: #1e3a5f;
      font-size: 0.85rem;
      font-weight: 500;
      line-height: 1.3;
    }

    .etiquetas {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 4px 0 8px;
    }

    .etiquetas span {
      display: inline-block;
      background: rgba(13, 71, 161, 0.06);
      color: #0d47a1;
      padding: 3px 12px;
      border-radius: 40px;
      font-size: 0.7rem;
      font-weight: 600;
      border: 1px solid rgba(13, 71, 161, 0.06);
    }

    .boton-ver {
      background: linear-gradient(135deg, #0d47a1, #0288d1);
      color: #fff;
      border: none;
      padding: 10px 20px;
      margin-top: 6px;
      border-radius: 60px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 4px 12px rgba(2, 136, 209, 0.2);
      font-family: 'Inter', sans-serif;
    }

    .boton-ver:hover {
      transform: scale(1.04);
      box-shadow: 0 6px 20px rgba(13, 71, 161, 0.3);
      background: linear-gradient(135deg, #0a2a44, #0d47a1);
    }

    /* ============================================================
       NAVEGACIÓN / PAGINACIÓN
    ============================================================ */
    .navegacion-contenedor {
      position: relative;
      z-index: 1;
      background: rgba(255, 255, 255, 0.70);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: 28px;
      border: 1px solid rgba(255,255,255,0.5);
      padding: 18px 28px;
      margin: 30px auto 10px auto;
      max-width: 500px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    }

    .navegacion {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
    }

    .navegacion button {
      padding: 10px 24px;
      font-size: 0.9rem;
      font-weight: 600;
      background: linear-gradient(135deg, #0d47a1, #0288d1);
      color: #fff;
      border: none;
      border-radius: 40px;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 4px 12px rgba(2, 136, 209, 0.2);
      font-family: 'Inter', sans-serif;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .navegacion button:hover {
      transform: scale(1.04);
      box-shadow: 0 6px 20px rgba(13, 71, 161, 0.3);
      background: linear-gradient(135deg, #0a2a44, #0d47a1);
    }

    #infoPagina {
      font-weight: 700;
      font-size: 0.95rem;
      color: #1a1a2e;
      background: rgba(255,255,255,0.4);
      padding: 4px 18px;
      border-radius: 40px;
      border: 1px solid rgba(255,255,255,0.3);
    }

    /* ============================================================
       RESPONSIVE
    ============================================================ */
    @media (max-width: 900px) {
      .filtros {
        flex-direction: column;
        gap: 16px;
        padding: 18px 20px;
      }
      
      .selector-servicio {
        border-right: none;
        border-bottom: 1px solid rgba(0,0,0,0.06);
        padding-right: 0;
        padding-bottom: 12px;
        width: 100%;
        align-items: center;
      }
      
      .botones-servicio {
        justify-content: center;
      }
      
      .contenedor-filtros {
        flex-direction: column;
        width: 100%;
      }
      
      .filtros input[type="text"],
      .filtros select {
        width: 100%;
        min-width: unset;
      }
      
      .carta-wrapper {
        width: 100%;
        margin: 0 0 30px 0;
      }
      
      .carta-superpuesta {
        transform: none;
      }
    }

    @media (max-width: 600px) {
      .card {
        grid-template-columns: 1fr;
        border-radius: 20px;
      }
      
      .card-imagen {
        width: 100%;
        height: 220px;
        border-radius: 20px 20px 0 0;
      }
      
      .card-contenido {
        padding: 14px;
      }
      
      .nombre-id {
        font-size: 1rem;
      }
      
      .titulo {
        font-size: 0.9rem;
      }
      
      .navegacion {
        gap: 12px;
      }
      
      .navegacion button {
        padding: 8px 16px;
        font-size: 0.8rem;
      }
    }

    @media (max-width: 480px) {
      body {
        padding: 12px;
      }
      
      .filtros {
        padding: 14px 16px;
        border-radius: 20px;
      }
      
      .selector-servicio button {
        font-size: 0.7rem;
        padding: 6px 12px;
      }
      
      .estado-servicio {
        font-size: 0.7rem;
      }
    }
    .btn-sqlserver.activo {
  background: #0078D4;
}
  </style>
</head>
<body data-letra="e">
  <div class="filtros">
    <!-- Selector de servicio en el costado izquierdo -->
    <div class="selector-servicio">
      <div class="botones-servicio">
        <button id="btnFirebase" class="activo btn-firebase" onclick="cambiarServicio('firebase')">Firebase</button>
        <button id="btnCloudflare" class="btn-cloudflare" onclick="cambiarServicio('cloudflare')">Cloudflare</button>
        <button id="btnSheets" class="btn-sheets" onclick="cambiarServicio('sheets')">Google Sheets</button>
        <button id="btnSQLServer" class="btn-sqlserver" onclick="cambiarServicio('sqlserver')">SQL Server</button>
      </div>
      <div class="estado-servicio" id="estadoServicio">Servicio: Firebase</div>
    </div>
    
    <!-- Filtros originales en línea -->
    <div class="contenedor-filtros">
      <input type="text" id="buscador" placeholder="Buscar serie por nombre...">
      <select id="nombreSelector"></select>
    </div>
  </div>

  <div id="cargaContainer" class="mensaje-carga" style="display: none;">
    <div>⏳ Cargando series desde <span id="servicioCarga"></span>...</div>
  </div>

  <div id="errorContainer" class="mensaje-error" style="display: none;"></div>

  <div class="contenedor-cards" id="cardsContainer"></div>

  <div class="navegacion-contenedor">
    <div class="navegacion">
      <button onclick="paginaAnterior()"><i class="fas fa-arrow-left"></i> Anterior</button>
      <span id="infoPagina"></span>
      <button onclick="paginaSiguiente()">Siguiente <i class="fas fa-arrow-right"></i></button>
    </div>
  </div>

  <script type="module" src="../../Config/config.js"></script><script type="module" src="../../Controllers/Letras_Controller.js"></script>
  
</body>
