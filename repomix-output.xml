      flex-wrap: wrap;
    }

    /* Dropdown de servicios — adaptado al azul */
    .service-dropdown {
      position: relative;
      display: inline-block;
    }

    .service-dropdown-toggle {
      background: rgba(255, 255, 255, 0.12);
      color: white;
      font-weight: 600;
      padding: 8px 20px 8px 16px;
