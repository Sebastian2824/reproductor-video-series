      font-size: 0.95rem;
      color: #0d47a1;
      line-height: 1.3;
    }

    .subtitulo {
      color: #1e3a5f;
      font-size: 0.85rem;
      font-weight: 500;
      line-height: 1.3;
    }

    .etiquetas {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 4px 0 8px;
    }

