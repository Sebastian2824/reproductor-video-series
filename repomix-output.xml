    .card-imagen {
      width: 160px;
      height: 250px;
      overflow: hidden;
      flex-shrink: 0;
    }

    .card-imagen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      transition: transform 0.5s ease;
    }

    .card:hover .card-imagen img {
      transform: scale(1.04);
    }

