      <button onclick="paginaSiguiente()">Siguiente <i class="fas fa-arrow-right"></i></button>
    </div>
  </div>

  <script type="module" src="../../Config/config.js"></script><script type="module" src="../../Controllers/Letras_Controller.js"></script>
  
</body>
