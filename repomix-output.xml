          <span id="seasonLang">Cargando...</span>
          <span id="episodeCount">0 episodios</span>
        </div>
        <select class="server-select" id="serverSelect" onchange="changeVideo(this.value)"></select>
        
        <!-- DROPDOWN PARA CAMBIAR SERVICIO -->
        <div class="service-dropdown" id="serviceDropdown">
          <button class="service-dropdown-toggle" id="serviceToggleBtn">
            <span id="serviceToggleText">Cambiar servicio</span>
            <i class="fas fa-chevron-down"></i>
          </button>
          <div class="service-dropdown-menu" id="serviceMenu">
            <div class="service-dropdown-item" data-service="firebase">
              <div>
                <i class="fas fa-database service-icon"></i>
                <span>Firebase</span>
              </div>
              <i class="fas fa-check service-check"></i>
            </div>
            <div class="service-dropdown-item" data-service="cloudflare">
              <div>
                <i class="fas fa-cloud service-icon"></i>
                <span>Cloudflare</span>
              </div>
              <i class="fas fa-check service-check"></i>
            </div>
            <div class="service-dropdown-item" data-service="sheets">
              <div>
                <i class="fas fa-table service-icon"></i>
                <span>Google Sheets</span>
              </div>
              <i class="fas fa-check service-check"></i>
            </div>
            <div class="service-dropdown-item" data-service="sqlserver">    <!-- 👈 NUEVO -->
    <div>
      <i class="fas fa-server service-icon"></i>
      <span>SQL Server</span>
    </div>
    <i class="fas fa-check service-check"></i>
  </div>
          </div>
        </div>
      </div>
      <div class="episode-list" id="sidebarPlaylist"></div>

      <!-- EN MÓVILES: SECCIÓN DE SERIES RECOMENDADAS VA AQUÍ -->
      <div class="recomendaciones-section" id="recomendacionesMobile" style="display: none;">
        <div class="recomendaciones-header">
          <h3>Series Recomendadas</h3>
          <span id="recomendacionesServiceIndicatorMobile" class="service-status-indicator service-active">
            <i class="fas fa-database"></i> Firebase
          </span>
        </div>
        <div class="recomendaciones-grid" id="recomendacionesGridMobile">
          <!-- Las 3 cards se cargarán aquí dinámicamente para móviles -->
        </div>
      </div>
    </div>
  </div>

  <!-- ====== JavaScript (IDÉNTICO AL ORIGINAL, SIN MODIFICACIONES) ====== -->
  <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-firestore-compat.js"></script>
  <script src="../Controllers/Reproductor_Universal_Opcional_Controller.js"></script>
</body>
</html>
